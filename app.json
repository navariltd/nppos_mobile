{
  "expo": {
    "name": "NPPOS",
    "slug": "nppos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "nppos",
    "primaryColor": "#FD6918",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.navari.nppos"
    },
    "android": {
      "package": "ke.co.navari.nppos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FD6918"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "NPPOS uses the camera to scan voucher QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NPPOS attaches a photo of the signed distribution sheet to the shift's closing entry.",
          "cameraPermission": "NPPOS uses the camera to capture the signed distribution sheet when closing a shift."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FD6918",
          "dark": {
            "backgroundColor": "#FD6918"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "026ff6c9-bceb-41ad-91aa-1ff07e3e6158"
      }
    },
    "owner": "emiliocliff"
  }
}
